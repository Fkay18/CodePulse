# Django
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL
MYSQL_DATABASE=database-name
MYSQL_USER=database-user
MYSQL_PASSWORD=database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Email
# Use the console backend locally; use SMTP settings in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-password-or-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your-email@example.com

# API
API_ANON_RATE=100/hour
API_USER_RATE=1000/hour
API_PAGE_SIZE=10
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
CORS_ALLOWED_ORIGINS=

# Production security. Keep these disabled for local HTTP development.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
